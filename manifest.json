{
  "manifest_version": 3,
  "name": "SmashMateCard",
  "description": "smashmate.netの計測開始以降の戦績を対戦IDで集計し、カード画像にして共有",
  "version": "1.2.0",
  "homepage_url": "https://github.com/jun-suzuki1028/SmashMateCard",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://smashmate.net/user/*"],
      "js": ["tracking.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
